+import "server-only";
+import { cookies } from "next/headers";
+import { NextResponse } from "next/server";
+import { validPasswordHash, verifySession } from "./security";
+import { HttpError, storageConfigured } from "./surprise-store";
+
+export const PRIVATE_HEADERS = {
+  "Cache-Control": "private, no-store, max-age=0", "CDN-Cache-Control": "no-store",
+  "Vercel-CDN-Cache-Control": "no-store", "X-Robots-Tag": "noindex, nofollow, noarchive",
+  "X-Content-Type-Options": "nosniff", "Vary": "Cookie",
+};
+export function json(data: unknown, status = 200) { return NextResponse.json(data, { status, headers: PRIVATE_HEADERS }); }
+export function authConfig() {
+  const secret = process.env.ADMIN_SESSION_SECRET ?? "", passwordHash = process.env.ADMIN_PASSWORD_HASH ?? "";
+  if (secret.length < 32 || !validPasswordHash(passwordHash)) throw new HttpError(503, "A área privada ainda não foi configurada.");
+  return { secret, passwordHash };
+}
+export function privateConfigured() {
+  try { authConfig(); return storageConfigured() && Boolean(process.env.APP_ORIGIN); } catch { return false; }
+}
+export function cookieName() { return process.env.NODE_ENV === "production" ? "__Host-vy_admin" : "vy_admin"; }
+export async function isAdmin() {
+  try {
+    const { secret, passwordHash } = authConfig();
+    return verifySession((await cookies()).get(cookieName())?.value, secret, passwordHash);
+  } catch { return false; }
+}
+export async function requireAdmin() { if (!(await isAdmin())) throw new HttpError(401, "Entre novamente para continuar."); }
+export function sameOrigin(request: Request) {
+  const expected = process.env.APP_ORIGIN;
+  // Require an explicitly configured origin, rather than trusting Host / forwarded headers.
+  if (!expected) throw new HttpError(503, "A área privada ainda não foi configurada.");
+  if (request.headers.get("origin") !== new URL(expected).origin || request.headers.get("sec-fetch-site") === "cross-site") throw new HttpError(403, "Origem não permitida.");
+}
+export async function readBytes(request: Request, max: number) {
+  const declared = Number(request.headers.get("content-length"));
+  if (Number.isFinite(declared) && declared > max) throw new HttpError(413, "Arquivo ou conteúdo muito grande.");
+  const reader = request.body?.getReader();
+  if (!reader) throw new HttpError(400, "Conteúdo vazio.");
+  const chunks: Uint8Array[] = []; let length = 0;
+  try {
+    while (true) {
+      const chunk = await reader.read(); if (chunk.done) break;
+      length += chunk.value.byteLength;
+      if (length > max) { await reader.cancel(); throw new HttpError(413, "Arquivo ou conteúdo muito grande."); }
+      chunks.push(chunk.value);
+    }
+  } finally { reader.releaseLock(); }
+  return Buffer.concat(chunks, length);
+}
+export async function readJson(request: Request, max = 200000) {
+  if (!request.headers.get("content-type")?.startsWith("application/json")) throw new HttpError(415, "Envie conteúdo JSON.");
+  try { return JSON.parse((await readBytes(request, max)).toString("utf8")); }
+  catch (error) { if (error instanceof HttpError) throw error; throw new HttpError(400, "Conteúdo inválido."); }
+}
+export function failure(error: unknown) {
+  if (error instanceof HttpError) return json({ error: error.message }, error.status);
+  return json({ error: "Não foi possível concluir. Tente novamente." }, 500);
+}
diff --git a/src/lib/server/security.ts b/src/lib/server/security.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e8f97c725d7be0e84b123ef296b14a96910848d3
--- /dev/null
+++ b/src/lib/server/security.ts
@@ -0,0 +1,27 @@
+import { createHmac, randomBytes, scryptSync, timingSafeEqual } from "node:crypto";
+
+export const SESSION_SECONDS = 4 * 60 * 60;
+export function validPasswordHash(value: string) { return /^scrypt:[0-9a-f]{32}:[0-9a-f]{128}$/.test(value); }
+export function checkPassword(password: unknown, stored: string) {
+  if (typeof password !== "string" || password.length > 256 || !validPasswordHash(stored)) return false;
+  const [, salt, expected] = stored.split(":");
+  const actual = scryptSync(password, salt, 64);
+  return timingSafeEqual(actual, Buffer.from(expected, "hex"));
+}
+export function signSession(secret: string, passwordHash: string, now = Date.now()) {
+  const payload = Buffer.from(JSON.stringify({ role: "admin", exp: Math.floor(now / 1000) + SESSION_SECONDS, nonce: randomBytes(16).toString("hex") })).toString("base64url");
+  return `${payload}.${createHmac("sha256", secret + passwordHash).update(payload).digest("base64url")}`;
+}
+export function verifySession(token: string | undefined, secret: string, passwordHash: string, now = Date.now()) {
+  if (!token || token.length > 1024 || secret.length < 32 || !validPasswordHash(passwordHash)) return false;
+  const [payload, sig, extra] = token.split(".");
+  if (!payload || !sig || extra !== undefined) return false;
+  const expected = createHmac("sha256", secret + passwordHash).update(payload).digest();
+  const supplied = Buffer.from(sig, "base64url");
+  if (expected.length !== supplied.length || !timingSafeEqual(expected, supplied)) return false;
+  try {
+    const data = JSON.parse(Buffer.from(payload, "base64url").toString("utf8"));
+    const seconds = Math.floor(now / 1000);
+    return data.role === "admin" && Number.isInteger(data.exp) && data.exp > seconds && data.exp <= seconds + SESSION_SECONDS;
+  } catch { return false; }
+}
diff --git a/src/lib/server/surprise-store.ts b/src/lib/server/surprise-store.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3e5750cb067a0ff77fe9fa5df149a3f052513d9e
--- /dev/null
+++ b/src/lib/server/surprise-store.ts
@@ -0,0 +1,48 @@
+import "server-only";
+import { type AdminSurprise, type SectionId, type PublicSurprise, publicSnapshot, referencedAssets, sectionIds } from "../surprises";
+
+export class HttpError extends Error { constructor(public status: number, message: string) { super(message); } }
+export const BUCKET = "private-surprises";
+export function storageConfigured() {
+  return Boolean(process.env.SUPABASE_URL && process.env.SUPABASE_SERVICE_ROLE_KEY);
+}
+function config() {
+  const url = process.env.SUPABASE_URL, key = process.env.SUPABASE_SERVICE_ROLE_KEY;
+  if (!url || !key) throw new HttpError(503, "A área privada ainda não foi configurada.");
+  const parsed = new URL(url);
+  if (parsed.protocol !== "https:" && !(process.env.NODE_ENV !== "production" && parsed.hostname === "127.0.0.1")) throw new HttpError(503, "Configuração privada inválida.");
+  return { url: parsed.origin, key };
+}
+export async function supabase(path: string, init: RequestInit = {}) {
+  const { url, key } = config();
+  const headers = new Headers(init.headers);
+  headers.set("apikey", key); headers.set("Authorization", `Bearer ${key}`);
+  let response: Response;
+  try { response = await fetch(`${url}${path}`, { ...init, headers, cache: "no-store", signal: AbortSignal.timeout(15000) }); }
+  catch { throw new HttpError(503, "O armazenamento privado não respondeu. Tente novamente."); }
+  if (!response.ok) {
+    // Do not log or return provider responses: they may contain personal content.
+    if (response.status === 409) throw new HttpError(409, "O conteúdo mudou em outra aba. Recarregue antes de salvar.");
+    throw new HttpError(503, "Não foi possível acessar o armazenamento privado. Verifique a configuração.");
+  }
+  return response;
+}
+export async function rpc(name: string, input: object) {
+  const response = await supabase(`/rest/v1/rpc/${name}`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(input) });
+  return response.json();
+}
+export async function adminSections(): Promise<AdminSurprise[]> {
+  const response = await supabase("/rest/v1/surprise_sections?select=id,draft,published,version,published_at&order=id");
+  return response.json();
+}
+export async function publicSections(): Promise<PublicSurprise[]> {
+  if (!storageConfigured()) return [];
+  // No drafts, metadata or private revisions are selected for a public request.
+  const response = await supabase("/rest/v1/surprise_sections?select=id,published&published=not.is.null");
+  const rows: { id: SectionId; published: AdminSurprise["published"] }[] = await response.json();
+  return rows.map((row) => publicSnapshot(row.id, row.published)).filter((row): row is PublicSurprise => row !== null)
+    .sort((a, b) => sectionIds.indexOf(a.id) - sectionIds.indexOf(b.id));
+}
+export async function publicAssetAllowed(asset: string) {
+  return (await publicSections()).some((section) => !section.locked && referencedAssets(section.content).has(asset));
+}
diff --git a/src/lib/surprises.ts b/src/lib/surprises.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9a46e57c52ece6939bc9cb5b64fe1536b5233545
--- /dev/null
+++ b/src/lib/surprises.ts
@@ -0,0 +1,83 @@
+// Only structure and neutral labels belong here. Personal content lives in the database.
+export const sectionIds = ["timeline", "stars", "capsule", "voice", "chapters", "reasons"] as const;
+export type SectionId = typeof sectionIds[number];
+export const sectionLabels: Record<SectionId, string> = {
+  timeline: "Linha do tempo", stars: "Estrelas com segredos", capsule: "Cápsula do tempo",
+  voice: "Mensagens com a sua voz", chapters: "Nossos próximos capítulos", reasons: "Um motivo para te amar",
+};
+export const letterOptions = [
+  { id: "", label: "Na seção de áudios" }, { id: "saudade", label: "Quando a saudade apertar" },
+  { id: "dia-dificil", label: "Quando o dia estiver difícil" }, { id: "sorriso", label: "Quando precisar de um sorriso" },
+  { id: "nos", label: "Quando quiser lembrar de nós" },
+];
+export type SurpriseItem = {
+  id: string; title: string; text: string; date: string; image: string; audio: string;
+  letter: string; done: boolean; x: number; y: number;
+};
+export type SurpriseContent = { title: string; intro: string; unlockAt: string; items: SurpriseItem[] };
+export type PublicSurprise = { id: SectionId; content: SurpriseContent; locked: boolean };
+export type AdminSurprise = {
+  id: SectionId; draft: SurpriseContent; published: SurpriseContent | null;
+  version: number; published_at: string | null;
+};
+export function isSectionId(value: unknown): value is SectionId {
+  return typeof value === "string" && sectionIds.includes(value as SectionId);
+}
+export function emptyContent(id: SectionId): SurpriseContent {
+  return { title: sectionLabels[id], intro: "", unlockAt: "", items: [] };
+}
+export function emptyItem(id: string): SurpriseItem {
+  return { id, title: "", text: "", date: "", image: "", audio: "", letter: "", done: false, x: 12, y: 25 };
+}
+export const assetPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\.(jpg|png|webp|mp3|m4a|ogg|wav|webm)$/;
+export function mediaUrl(asset: string) { return `/api/surprises/media/${encodeURIComponent(asset)}`; }
+
+// Explicitly rebuild the object: never persist arbitrary client fields or external asset URLs.
+export function validateContent(value: unknown): SurpriseContent {
+  if (!value || typeof value !== "object") throw new Error("Conteúdo inválido.");
+  const v = value as Record<string, unknown>;
+  function str(input: unknown, max: number) {
+    if (typeof input !== "string" || input.length > max) throw new Error("Texto inválido ou muito longo.");
+    return input.trim();
+  }
+  const title = str(v.title, 160), intro = str(v.intro, 4000), unlockAt = str(v.unlockAt, 40);
+  if (!title) throw new Error("Escreva um título.");
+  if (unlockAt && (!/^\d{4}-\d\d-\d\dT\d\d:\d\d(?::\d\d(?:\.\d{3})?)?(Z|[+-]\d\d:\d\d)$/.test(unlockAt) || !Number.isFinite(Date.parse(unlockAt)))) throw new Error("Data de abertura inválida.");
+  if (!Array.isArray(v.items) || v.items.length > 100) throw new Error("Use até 100 itens por novidade.");
+  const seen = new Set<string>();
+  const items = v.items.map((input): SurpriseItem => {
+    if (!input || typeof input !== "object") throw new Error("Item inválido.");
+    const i = input as Record<string, unknown>;
+    const id = str(i.id, 80);
+    if (!/^[a-zA-Z0-9-]{1,80}$/.test(id) || seen.has(id)) throw new Error("Identificador repetido ou inválido.");
+    seen.add(id);
+    const image = str(i.image, 80), audio = str(i.audio, 80), date = str(i.date, 10), letter = str(i.letter, 20);
+    if ((image && (!assetPattern.test(image) || !/\.(jpg|png|webp)$/.test(image))) || (audio && (!assetPattern.test(audio) || !/\.(mp3|m4a|ogg|wav|webm)$/.test(audio)))) throw new Error("Arquivo inválido. Use o envio pelo painel.");
+    if (date && (!/^\d{4}-\d\d-\d\d$/.test(date) || !Number.isFinite(Date.parse(date)))) throw new Error("Data do item inválida.");
+    if (!letterOptions.some((l) => l.id === letter)) throw new Error("Cartinha inválida.");
+    if (typeof i.done !== "boolean" || typeof i.x !== "number" || typeof i.y !== "number" || !Number.isFinite(i.x) || !Number.isFinite(i.y) || i.x < 3 || i.x > 97 || i.y < 3 || i.y > 97) throw new Error("Posição da estrela inválida (3 a 97%).");
+    return { id, title: str(i.title, 160), text: str(i.text, 12000), date, image, audio, letter, done: i.done, x: i.x, y: i.y };
+  });
+  return { title, intro, unlockAt, items };
+}
+export function validatePublication(id: SectionId, content: SurpriseContent) {
+  if (!content.items.length) throw new Error("Adicione pelo menos um item antes de liberar.");
+  if (id === "capsule" && !content.unlockAt) throw new Error("Escolha a data e o horário da cápsula.");
+  for (const item of content.items) {
+    if (!item.title && !item.text) throw new Error("Preencha um título ou uma mensagem em cada item.");
+    if (id === "voice" && !item.audio) throw new Error("Envie o áudio de cada mensagem antes de liberar.");
+    if (id === "timeline" && !item.date) throw new Error("Preencha a data de cada marco.");
+  }
+}
+export function publicSnapshot(id: SectionId, value: SurpriseContent | null, now = Date.now()): PublicSurprise | null {
+  if (!value) return null;
+  const content = validateContent(value);
+  if (id === "capsule" && (!content.unlockAt || Date.parse(content.unlockAt) > now)) {
+    // Neither the future letter nor its media IDs or intro are sent before the server clock permits it.
+    return { id, locked: true, content: { title: content.title, intro: "", unlockAt: content.unlockAt, items: [] } };
+  }
+  return { id, content, locked: false };
+}
+export function referencedAssets(content: SurpriseContent) {
+  return new Set(content.items.flatMap((item) => [item.image, item.audio]).filter(Boolean));
+}
diff --git a/supabase/surprises.sql b/supabase/surprises.sql
new file mode 100644
index 0000000000000000000000000000000000000000..d1ab4f7444467f998eed329e03afcf39b9857636
--- /dev/null
+++ b/supabase/surprises.sql
@@ -0,0 +1,74 @@
+-- Run in a SEPARATE Supabase project. Contains structure and empty slots only.
+begin;
+create table if not exists public.surprise_sections (
+  id text primary key check (id in ('timeline', 'stars', 'capsule', 'voice', 'chapters', 'reasons')),
+  draft jsonb not null,
+  published jsonb,
+  version integer not null default 0,
+  published_at timestamptz
+);
+alter table public.surprise_sections enable row level security;
+revoke all on public.surprise_sections from public, anon, authenticated;
+grant select, update on public.surprise_sections to service_role;
+insert into public.surprise_sections(id, draft)
+select id, jsonb_build_object('title', title, 'intro', '', 'unlockAt', '', 'items', '[]'::jsonb)
+from (values ('timeline', 'Linha do tempo'), ('stars', 'Estrelas com segredos'),
+  ('capsule', 'Cápsula do tempo'), ('voice', 'Mensagens com a sua voz'),
+  ('chapters', 'Nossos próximos capítulos'), ('reasons', 'Um motivo para te amar')) as slots(id, title)
+on conflict (id) do nothing;
+
+create table if not exists public.surprise_login_limits (
+  key text primary key, attempts integer not null, expires_at timestamptz not null
+);
+alter table public.surprise_login_limits enable row level security;
+revoke all on public.surprise_login_limits from public, anon, authenticated;
+
+create or replace function public.surprise_login_attempt(client_key text) returns boolean
+language plpgsql security definer set search_path = public, pg_temp as $$
+declare global_count integer; client_count integer;
+begin
+  if client_key !~ '^[0-9a-f]{64}$' then return false; end if;
+  -- Serialize the two counters, also across serverless instances.
+  perform pg_advisory_xact_lock(714963125);
+  delete from public.surprise_login_limits where expires_at <= now();
+  select attempts into global_count from public.surprise_login_limits where key = 'global';
+  select attempts into client_count from public.surprise_login_limits where key = client_key;
+  if coalesce(global_count, 0) >= 50 or coalesce(client_count, 0) >= 8 then return false; end if;
+  insert into public.surprise_login_limits(key, attempts, expires_at)
+  values ('global', 1, now() + interval '15 minutes'), (client_key, 1, now() + interval '15 minutes')
+  on conflict (key) do update set attempts = surprise_login_limits.attempts + 1;
+  return true;
+end;
+$$;
+revoke all on function public.surprise_login_attempt(text) from public, anon, authenticated;
+grant execute on function public.surprise_login_attempt(text) to service_role;
+
+create or replace function public.surprise_update(section_id text, expected_version integer, operation text, content jsonb)
+returns jsonb language plpgsql security definer set search_path = public, pg_temp as $$
+declare current_row public.surprise_sections;
+begin
+  select * into current_row from public.surprise_sections where id = section_id for update;
+  if not found or current_row.version <> expected_version then return null; end if;
+  if operation not in ('save', 'publish', 'hide') then raise exception 'Invalid operation'; end if;
+  if operation <> 'hide' and (content is null or jsonb_typeof(content) <> 'object') then raise exception 'Invalid content'; end if;
+  update public.surprise_sections set
+    draft = case when operation = 'hide' then draft else content end,
+    published = case when operation = 'publish' then content when operation = 'hide' then null else published end,
+    published_at = case when operation = 'publish' then now() when operation = 'hide' then null else published_at end,
+    version = version + 1
+  where id = section_id returning * into current_row;
+  return to_jsonb(current_row);
+end;
+$$;
+revoke all on function public.surprise_update(text, integer, text, jsonb) from public, anon, authenticated;
+grant execute on function public.surprise_update(text, integer, text, jsonb) to service_role;
+
+insert into storage.buckets(id, name, public, file_size_limit, allowed_mime_types)
+values ('private-surprises', 'private-surprises', false, 3145728,
+  array['image/jpeg','image/png','image/webp','audio/mpeg','audio/mp4','audio/x-m4a','audio/ogg','audio/wav','audio/x-wav','audio/webm'])
+on conflict(id) do update set public = false, file_size_limit = excluded.file_size_limit, allowed_mime_types = excluded.allowed_mime_types;
+-- Even an existing permissive policy on another bucket must not open this one.
+drop policy if exists protect_private_surprises on storage.objects;
+create policy protect_private_surprises on storage.objects as restrictive for all to anon, authenticated
+using (bucket_id <> 'private-surprises') with check (bucket_id <> 'private-surprises');
+commit;
diff --git a/tests/privacy.test.mjs b/tests/privacy.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9196a1d7a8627cf316c285b66e983352b6cf73d2
--- /dev/null
+++ b/tests/privacy.test.mjs
@@ -0,0 +1,89 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { randomBytes, scryptSync } from "node:crypto";
+import { emptyContent, emptyItem, validateContent, validatePublication, publicSnapshot, referencedAssets, assetPattern } from "../src/lib/surprises.ts";
+import { signSession, verifySession, checkPassword, SESSION_SECONDS } from "../src/lib/server/security.ts";
+import { mediaExtension } from "../src/lib/server/media.ts";
+
+const salt = randomBytes(16).toString("hex"), password = randomBytes(24).toString("hex");
+const hash = `scrypt:${salt}:${scryptSync(password, salt, 64).toString("hex")}`;
+const secret = randomBytes(48).toString("hex"), now = Date.parse("2030-01-01T00:00:00Z");
+function content(id = "timeline") {
+  return { ...emptyContent(id), intro: "PRIVATE INTRO CANARY", items: [{ ...emptyItem("test-item"), text: "PRIVATE BODY CANARY", date: "2030-01-01", image: "a1b2c3d4-1234-4234-8234-123456789abc.jpg" }] };
+}
+test("correct password is verified; wrong, missing and malformed passwords fail", () => {
+  assert.equal(checkPassword(password, hash), true);
+  for (const value of ["wrong", null, {}, "a".repeat(257)]) assert.equal(checkPassword(value, hash), false);
+  assert.equal(checkPassword(password, "unset"), false);
+});
+test("signed admin session expires and cannot be extended by a client", () => {
+  const token = signSession(secret, hash, now);
+  assert.equal(verifySession(token, secret, hash, now), true);
+  assert.equal(verifySession(token, secret, hash, now + SESSION_SECONDS * 1000), false);
+  const [payload, signature] = token.split(".");
+  const parsed = JSON.parse(Buffer.from(payload, "base64url")); parsed.exp += 100000;
+  assert.equal(verifySession(`${Buffer.from(JSON.stringify(parsed)).toString("base64url")}.${signature}`, secret, hash, now), false);
+});
+test("session rejects forged tokens and is invalidated by credential rotation", () => {
+  const token = signSession(secret, hash, now);
+  for (const value of [undefined, "admin", token + ".extra", "x.y", "a".repeat(1025)]) assert.equal(verifySession(value, secret, hash, now), false);
+  assert.equal(verifySession(token, secret + "rotated", hash, now), false);
+  assert.equal(verifySession(token, secret, hash.replace(salt, randomBytes(16).toString("hex")), now), false);
+});
+test("an unreleased section has no public representation", () => {
+  assert.equal(publicSnapshot("timeline", null, now), null);
+});
+test("a future capsule exposes neither message, intro nor media identifiers", () => {
+  const draft = { ...content("capsule"), unlockAt: "2031-01-01T00:00:00Z" };
+  const snapshot = publicSnapshot("capsule", draft, now), serialized = JSON.stringify(snapshot);
+  assert.equal(snapshot.locked, true);
+  assert.deepEqual(snapshot.content.items, []);
+  assert.equal(snapshot.content.intro, "");
+  assert.equal(serialized.includes("PRIVATE"), false);
+  assert.equal(serialized.includes(draft.items[0].image), false);
+  assert.equal(referencedAssets(snapshot.content).size, 0);
+});
+test("capsule is released exactly when the server clock reaches its deadline", () => {
+  const draft = { ...content("capsule"), unlockAt: "2031-01-01T00:00:00Z" };
+  const deadline = Date.parse(draft.unlockAt);
+  assert.equal(publicSnapshot("capsule", draft, deadline - 1).locked, true);
+  assert.equal(publicSnapshot("capsule", draft, deadline).locked, false);
+  assert.equal(publicSnapshot("capsule", draft, deadline).content.items[0].text, "PRIVATE BODY CANARY");
+});
+test("published snapshots do not share references with a subsequent draft", () => {
+  const published = content(); const snapshot = publicSnapshot("timeline", published, now);
+  published.items[0].text = "NEW PRIVATE REVISION";
+  assert.equal(snapshot.content.items[0].text, "PRIVATE BODY CANARY");
+  assert.equal(JSON.stringify(snapshot).includes("NEW PRIVATE REVISION"), false);
+});
+test("content validation removes unknown fields and refuses external asset URLs", () => {
+  const draft = content(); assert.equal(validateContent({ ...draft, secret: "never copied" }).secret, undefined);
+  draft.items[0].image = "https://example.org/private.jpg";
+  assert.throws(() => validateContent(draft), /Arquivo inválido/);
+});
+test("traversal and incorrect media formats are not accepted", () => {
+  for (const value of ["../secret.jpg", "name.svg", "a/b.jpg", "%2e%2e", "https://example.org"]) assert.equal(assetPattern.test(value), false);
+  const draft = content(); draft.items[0].audio = draft.items[0].image;
+  assert.throws(() => validateContent(draft), /Arquivo inválido/);
+});
+test("publishing requires content, a capsule date, timeline dates and voice files", () => {
+  assert.throws(() => validatePublication("timeline", emptyContent("timeline")), /pelo menos/);
+  assert.throws(() => validatePublication("capsule", content("capsule")), /data e o horário/);
+  assert.throws(() => validatePublication("voice", content("voice")), /áudio/);
+  const draft = content(); draft.items[0].date = "";
+  assert.throws(() => validatePublication("timeline", draft), /data/);
+});
+test("unknown letters, duplicate IDs and invalid star positions fail validation", () => {
+  const draft = content(); draft.items.push({ ...draft.items[0] });
+  assert.throws(() => validateContent(draft), /repetido/);
+  draft.items.pop(); draft.items[0].letter = "unknown";
+  assert.throws(() => validateContent(draft), /Cartinha/);
+  draft.items[0].letter = ""; draft.items[0].x = NaN;
+  assert.throws(() => validateContent(draft), /Posição/);
+});
+test("upload sniffs file signatures and refuses HTML disguised as an image", () => {
+  assert.equal(mediaExtension("image/jpeg", Buffer.from("<html>not a photo</html>")), null);
+  assert.equal(mediaExtension("image/svg+xml", Buffer.from("<svg/>")), null);
+  assert.equal(mediaExtension("image/png", Buffer.from([137, 80, 78, 71, 13, 10, 26, 10])), "png");
+  assert.equal(mediaExtension("audio/mpeg", Buffer.from("ID3 test")), "mp3");
+});
